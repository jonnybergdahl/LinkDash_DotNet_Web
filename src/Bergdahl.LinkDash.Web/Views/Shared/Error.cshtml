@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="card narrow">
    <h1 class="card-title error-text">Something went wrong</h1>
    <p>An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="button text" asp-controller="Home" asp-action="Index">Back to dashboard</a>
</section>
