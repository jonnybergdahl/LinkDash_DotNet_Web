<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Bergdahl.LinkDash.Core\Bergdahl.LinkDash.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The local data file must never be published, or a deployment would overwrite the server's links. -->
  <ItemGroup>
    <Content Update="App_Data\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
